<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.1"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd">

    <persistence-unit name="MoneyTransferPU" transaction-type="JTA">

        <jta-data-source>java:/jdbc/MoneyTransferDS</jta-data-source>

        <class>ma.transfert.model.User</class>
        <class>ma.transfert.model.Agency</class>
        <class>ma.transfert.model.Transfer</class>
        <class>ma.transfert.model.AuditLog</class>
        <class>ma.transfert.model.Document</class>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="update"/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>

            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <property name="hibernate.cache.use_second_level_cache" value="false"/>
        </properties>

    </persistence-unit>
</persistence>